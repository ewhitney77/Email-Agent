# Copy to .env and edit. All values are optional; defaults work out of the box.

# --- Matching ---------------------------------------------------------------
# Similarity score (0-1) above which a posting is flagged.
MATCH_THRESHOLD=0.75

# Embedding backend: "sentence-transformers" (free/local, default) or "openai".
EMBEDDING_BACKEND=sentence-transformers

# sentence-transformers model (used when backend=sentence-transformers).
ST_MODEL=all-MiniLM-L6-v2

# OpenAI settings (used only when EMBEDDING_BACKEND=openai).
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small   # or text-embedding-ada-002

# --- Scraping ---------------------------------------------------------------
REQUEST_TIMEOUT=20
MAX_LISTINGS_PER_COMPANY=60
USE_PLAYWRIGHT=true

# --- Email alerts (optional) ------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER=you@gmail.com
SMTP_RECIPIENT=ewhitney777@gmail.com
