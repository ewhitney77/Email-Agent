# Anthropic API key for resume tailoring
ANTHROPIC_API_KEY=sk-ant-...

# Where to send match alerts. The agent uses Gmail's API to send from
# the same account it scrapes, so this just controls the To: address.
NOTIFY_EMAIL=you@example.com

# Path to Google OAuth client secrets (download from Google Cloud Console).
# Enable the Gmail API, create an OAuth 2.0 Client ID of type "Desktop app",
# download the JSON, and point this at it.
GOOGLE_CLIENT_SECRETS=./secrets/client_secret.json

# Where the OAuth refresh token gets cached after first run.
GOOGLE_TOKEN_PATH=./secrets/token.json

# SQLite DB tracking seen jobs so we don't re-alert.
STATE_DB_PATH=./state.sqlite

# Where tailored resumes get written.
OUTBOX_DIR=./outbox
